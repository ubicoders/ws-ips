# sb module definition, template. workspace/setup.sh writes sb.dev.yml from it
# with <REPO> replaced; sb.dev.yml is gitignored because `root:` is absolute.
# The cam_param queryable is not a pub/sub entry: setup.sh runs
# `sb service init --module ips_track`, which writes swarmbotix_io/service.rs.
module: ips_track
language: rust
root: <REPO>/ips_track
io_dir: swarmbotix_io
publishers:
  - name: cube_poses                 # <device>/ws_ips/ips_track/zenoh/cube_poses
    topic: cube_poses
    type: ros2/custom/CubePoses
    transport: zenoh
subscribers:
  # Bare topic on purpose; main() overrides `full` at startup to the wildcard
  # <device>/ws_ips/ips_detect-$*/zenoh/markers (every detector instance).
  - name: markers
    topic: markers
    type: ros2/custom/MarkerDetections
    transport: zenoh
